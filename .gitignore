# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Signing secrets — never commit
android/key.properties
*.jks
*.keystore

# ── Build-only repo: keep just what's needed to build Android + iOS ──
# Numbered local build outputs (APK/IPA live on the server, not in git).
/builds/

# Other platform projects — we only build Android + iOS. These stay on disk
# (regenerate with `flutter create` if you ever target them) but off GitHub.
/macos/
/windows/
/linux/
/web/

# Dev-only Dart tools + generated dev config (not needed to build the app).
/tool/
/devtools_options.yaml
