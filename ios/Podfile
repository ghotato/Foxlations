# Global iOS platform — must be >= the highest plugin minimum (google_mlkit
# needs 15.5).
platform :ios, '15.5'

# CocoaPods analytics slows flutter build; disable.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  # Parity with android/app/build.gradle.kts (text-recognition-{chinese,
  # japanese,korean,devanagari}). The google_mlkit_text_recognition podspec
  # only pulls GoogleMLKit/TextRecognition (Latin), and its native plugin gates
  # the other scripts behind `#if __has_include(...)` with `default:` — the
  # LATIN case — first in the switch. So without these pods, asking for
  # japanese/korean/chinese silently returns a LATIN recognizer: no exception,
  # no log, just garbage OCR on every CJK page.
  pod 'GoogleMLKit/TextRecognitionChinese',    '~> 7.0.0'
  pod 'GoogleMLKit/TextRecognitionDevanagari', '~> 7.0.0'
  pod 'GoogleMLKit/TextRecognitionJapanese',   '~> 7.0.0'
  pod 'GoogleMLKit/TextRecognitionKorean',     '~> 7.0.0'

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

# google_mlkit_text_recognition's README asks for these two project-level
# settings alongside the language pods. Missing them is one candidate for why
# the CJK recognisers didn't link on the first attempt.
$iOSVersion = '15.5'

MLKIT_SCRIPTS = %w[Chinese Devanagari Japanese Korean]

post_install do |installer|
  installer.pods_project.build_configurations.each do |config|
    config.build_settings['EXCLUDED_ARCHS[sdk=*]'] = 'armv7'
    config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = $iOSVersion
  end

  # google_mlkit_text_recognition gates its CJK recognisers behind
  #   #if __has_include(<MLKitTextRecognitionJapanese/...>)
  # but its podspec only depends on GoogleMLKit/TextRecognition (Latin).
  # CocoaPods scopes search paths per pod target, so declaring the language
  # pods on the Runner target — which CI confirmed installs and locks them
  # correctly — still leaves them invisible to the PLUGIN's own compilation.
  # The guards stay false, the switch falls through to Latin, and the linker
  # drops the unreferenced frameworks (binary unchanged at ~80.5 MB).
  # Put them on the plugin target's search paths so the headers resolve.
  installer.pods_project.targets.each do |target|
    next unless target.name == 'google_mlkit_text_recognition'

    target.build_configurations.each do |config|
      %w[FRAMEWORK_SEARCH_PATHS HEADER_SEARCH_PATHS].each do |key|
        paths = config.build_settings[key] || ['$(inherited)']
        paths = [paths] if paths.is_a?(String)
        MLKIT_SCRIPTS.each do |s|
          pod = "MLKitTextRecognition#{s}"
          if key == 'FRAMEWORK_SEARCH_PATHS'
            paths << %("${PODS_XCFRAMEWORKS_BUILD_DIR}/#{pod}")
            paths << %("${PODS_ROOT}/#{pod}/Frameworks")
          else
            paths << %("${PODS_ROOT}/Headers/Public/#{pod}")
          end
        end
        config.build_settings[key] = paths.uniq
      end
    end
  end

  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    target.build_configurations.each do |config|
      config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = $iOSVersion
    end
  end
end
