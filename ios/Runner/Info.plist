<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Foxlations</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>manga_reader</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<!-- ── iOS parity with AndroidManifest.xml ──────────────────────────── -->
	<!-- Android sets usesCleartextTraffic="true". WKWebView (Cloudflare
	     bypass, cookie extraction, OAuth) is fully ATS-governed, so without
	     this every http:// source page and mixed-content subresource is
	     blocked on iOS only. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<true/>
		<key>NSAllowsArbitraryLoadsInWebContent</key>
		<true/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- Backups, exported sources and downloaded chapters live in the app's
	     Documents dir. Without these two keys that directory is invisible in
	     the Files app, so a backup can never be retrieved off the device. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>
	<!-- MyAnimeList's OAuth redirect (foxlations://auth). The flow is
	     intercepted in-WebView, but registering the scheme stops iOS from
	     dropping the URL if a redirect ever escapes the WebView. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.foxlations.mangaReader.oauth</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>foxlations</string>
			</array>
		</dict>
	</array>
	<!-- iOS has no system UTI for cbz/cbr, so file_picker silently drops them
	     and they appear greyed out in the document picker. Declaring them
	     restores local import and enables "Open in Foxlations". -->
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.foxlations.cbz</string>
			<key>UTTypeDescription</key>
			<string>Comic Book Archive (ZIP)</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.zip-archive</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>cbz</string>
				</array>
			</dict>
		</dict>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.foxlations.cbr</string>
			<key>UTTypeDescription</key>
			<string>Comic Book Archive (RAR)</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>public.archive</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>cbr</string>
					<string>rar</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>Comic / Book Archive</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>com.foxlations.cbz</string>
				<string>com.foxlations.cbr</string>
				<string>public.zip-archive</string>
				<string>org.idpf.epub-container</string>
				<string>com.adobe.pdf</string>
			</array>
		</dict>
	</array>
	<!-- WKWebView reaches Photos/Camera on its own for <input type="file"> and
	     long-press "Save Image" on arbitrary source sites. Hitting either
	     without a usage string is an immediate SIGABRT, not a denial. -->
	<key>NSPhotoLibraryUsageDescription</key>
	<string>Foxlations needs photo access to import images you choose.</string>
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Foxlations needs permission to save manga pages and exported files to your photo library.</string>
	<key>NSCameraUsageDescription</key>
	<string>Foxlations needs camera access when a website asks you to take a photo.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Foxlations needs microphone access when a website asks to record audio.</string>
	<!-- The Koharu AI translation server usually runs on the user's LAN.
	     Since iOS 14 that requires this key or the connection fails silently. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>Foxlations connects to a translation server running on your local network.</string>
	<!-- Paired with the AVAudioSession .playback category set in
	     AppDelegate.swift — without this key, backgrounding while playing
	     gets the app killed by the watchdog. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>
</dict>
</plist>
